# Imagen del balanceador para AWS Lambda (contenedor) — distinta de
# `Dockerfile` (esa es para docker-compose/EC2 con uvicorn). Ver
# GUIA-DESPLIEGUE.md, sección "Balanceador en Lambda".
FROM public.ecr.aws/lambda/python:3.12

COPY requirements-lambda.txt .
RUN pip install --no-cache-dir -r requirements-lambda.txt

COPY balanceador/ ${LAMBDA_TASK_ROOT}/balanceador/

CMD ["balanceador.main.handler"]
