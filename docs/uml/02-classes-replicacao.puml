@startuml classes-replicacao
' Nucleo distribuido: replicacao por quorum e eleicao por maioria.
' Renderizar:  plantuml -tsvg docs/uml/02-classes-replicacao.puml
skinparam classAttributeIconSize 0
skinparam shadowing false
title Banco Distribuido -- Replicacao e Eleicao

package "bank.replication" {

  class ReplicatedLog {
    - wal : WriteAheadLog
    - commit_index : int
    + match_idx : Map<str,int>
    + next_idx : Map<str,int>
    --
    + append_local_buffered(op, epoch) : LogEntry
    + record_match(node_id, idx) : void
    + advance_commit(epoch) : int
    + next_batch_for(node_id) : (int,int,List)
    + back_off(node_id, hint) : void
    + matches(prev_idx, prev_epoch) : bool
    + append_from_leader(prev_idx, entries) : int
    + set_commit(leader_commit) : int
  }
  note right of ReplicatedLog
    **advance_commit** so confirma por contagem
    entradas do **epoch corrente**. Uma entrada
    herdada e confirmada por arraste, junto com
    o NOOP da promocao. Ignorar isso permite
    reverter operacao ja confirmada.
  end note

  class PrimaryReplicator {
    - quorum : int
    - store_lock : RLock
    - _append_lock : Lock
    --
    + submit(Operation) : OperationResult
    + replicate(up_to_idx, timeout) : bool
    + commit_noop() : void
    + apply_committed() : int
    + has_write_quorum() : bool
    + ensure_writable() : void
    - _peer_loop(node_id) : void
    - _push_once(node_id) : bool
  }
  note bottom of PrimaryReplicator
    Uma thread por replica envia continuamente
    a cauda pendente; ``submit`` so acorda essas
    threads e espera o commit. N escritas viram
    **um** AppendEntries com N entradas.
  end note

  class ReplicaApplier {
    - store_lock : RLock
    --
    + handle_append_entries(msg) : AppendAck
    + apply_committed() : int
  }

  class AppendEntries <<mensagem>> {
    + epoch : int
    + leader_id : str
    + prev_idx : int
    + prev_epoch : int
    + entries : List<LogEntry>
    + leader_commit : int
  }
  class AppendAck <<mensagem>> {
    + epoch : int
    + success : bool
    + match_idx : int
    + node_id : str
  }
  class RequestVote <<mensagem>> {
    + epoch : int
    + candidate_id : str
    + last_idx : int
    + last_epoch : int
  }
  class VoteReply <<mensagem>> {
    + epoch : int
    + granted : bool
    + reason : str
  }
}

package "bank.election" {
  enum NodeRole {
    REPLICA
    CANDIDATE
    PRIMARY
  }

  class NodeState {
    + node_id : str
    - role : NodeRole
    - epoch : int
    - voted_for : str
    --
    + observe_epoch(epoch, leader) : bool
    + start_candidacy() : int
    + grant_vote(epoch, candidate) : bool
    + become_primary() : void
    + step_down(epoch) : void
  }
  note right of NodeState
    ``epoch`` e ``voted_for`` sao gravados com
    fsync **antes** de irem em qualquer mensagem:
    votar, cair e esquecer o voto elegeria dois
    primarios.
  end note

  class ElectionManager {
    - quorum : int
    --
    + start_election() : ElectionOutcome
    + handle_request_vote(msg) : VoteReply
  }
  note bottom of ElectionManager
    Voto concedido so se: epoch >= o meu,
    ainda nao votei neste epoch, **e** o log do
    candidato esta pelo menos tao atualizado.
    A ultima condicao garante que nenhuma
    operacao confirmada se perca.
  end note

  class HeartbeatSender {
    + start() / stop()
    + notify_activity(node_id)
    + alive_peers(janela) : Map<str,bool>
  }
  class ElectionTimer {
    - min_timeout_s / max_timeout_s
    --
    + reset() : void
    + start() / stop()
  }
  note bottom of ElectionTimer
    Timeout sorteado por no (semente global +
    id do no). Semente **compartilhada** faria
    todos virarem candidatos juntos e dividirem
    os votos para sempre.
  end note

  enum ElectionOutcome {
    WON
    LOST
    STEPPED_DOWN
  }
}

package "bank.concurrency" {
  class AccountLockManager {
    - locks : Map<str,Lock>
    --
    + acquire(ids, timeout) : contexto
    + held_count() : int
  }
  note right of AccountLockManager
    Locks tomados **sempre** em ordem crescente
    de id -- deadlock impossivel por construcao.
  end note
}

interface PeerClient <<protocolo>> {
  + append_entries(node, msg, timeout) : AppendAck
  + request_vote(node, msg, timeout) : VoteReply
}
class HttpPeerClient
class InMemoryPeerClient
PeerClient <|.. HttpPeerClient
PeerClient <|.. InMemoryPeerClient

PrimaryReplicator "1" --> "1" ReplicatedLog
PrimaryReplicator "1" --> "1" NodeState
PrimaryReplicator "1" --> "1" AccountLockManager
PrimaryReplicator "1" --> "1" PeerClient : envia
PrimaryReplicator ..> AppendEntries : <<cria>>
PrimaryReplicator "1" --> "1" HeartbeatSender
ReplicaApplier "1" --> "1" ReplicatedLog
ReplicaApplier "1" --> "1" NodeState
ReplicaApplier ..> AppendAck : <<responde>>
ReplicaApplier "1" --> "1" ElectionTimer : reset()
ElectionManager "1" --> "1" NodeState
ElectionManager "1" --> "1" PeerClient
ElectionManager ..> RequestVote : <<cria>>
ElectionManager ..> VoteReply : <<responde>>
ElectionManager ..> ElectionOutcome
ElectionTimer ..> ElectionManager : dispara start_election()
NodeState --> NodeRole
AppendEntries ..> AppendAck : responde

@enduml
