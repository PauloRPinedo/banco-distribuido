# Imagem do balanceador para o AWS Lambda (contentor) — diferente de
# `Dockerfile` (essa é para docker-compose/EC2 com uvicorn). Ver
# GUIA-IMPLANTACAO.md, secção "Balanceador em Lambda".
FROM public.ecr.aws/lambda/python:3.12

COPY requisitos.txt requisitos-lambda.txt .
RUN pip install --no-cache-dir -r requisitos-lambda.txt

COPY balanceador/ ${LAMBDA_TASK_ROOT}/balanceador/

CMD ["balanceador.main.handler"]
