# Copiar para `.env` e preencher. O `.env` está no .gitignore e nunca é
# versionado: a senha da base não pode chegar ao GitHub.
#
#     cp .env.exemplo .env
#
# Usado por `docker compose -f compose.nuvem.yaml`. Ver REDE.md.

# `A` num portátil e `B` no outro. Se os dois disserem `A`, o banco funciona na
# mesma — mas deixa de se saber qual dos ecrãs é qual, e a demonstração perde-se.
NO_ID=A

# A MESMA linha nos dois portáteis: é isso que os faz partilhar as contas.
# O `?sslmode=require` no fim não é opcional numa base gerida.
BANCO_BD=postgresql://utilizador:senha@ep-xxxx.eu-central-1.aws.neon.tech/banco?sslmode=require
